# Environment configuration for AI ThreatModel Studio
ENVIRONMENT=development
PROJECT_NAME="AI ThreatModel Studio"

# Database Configuration (PostgreSQL for Docker, SQLite for standalone local testing)
# In Docker: postgresql://threatuser:threatpassword@database:5432/threatdb
# Local standalone: sqlite:///./threatmodel.db
DATABASE_URL=sqlite:///./threatmodel.db

# Redis & Celery (Optional for local standalone, active in Docker)
REDIS_URL=redis://localhost:6379/0

# Security & JWT
SECRET_KEY=threat-model-studio-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers Configuration
# Cloud: OpenAI API (optional if using Ollama or High-Fidelity Simulation)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Local: Ollama (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Storage Paths
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports

# CORS Configuration
CORS_ORIGINS=["*"]
